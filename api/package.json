{
	"name": "simple-api-starter-template",
	"version": "1.0.0",
	"description": "A simple Express + Prisma API starter template",
	"main": "index.ts",
	"type": "module",
	"scripts": {
		"dev": "node --watch --env-file=.env.local src/app/server.ts",
		"start": "node --env-file=.env src/app/server.ts",
		"test:db": "npx dotenv -e .env.test -- npx prisma migrate reset --force",
		"test": "npm run test:db && vitest",
		"type-check": "tsc"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^8.1.0",
		"@prisma/client": "^6.17.1",
		"bcrypt": "^5.1.1",
		"connect-redis": "^9.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"express": "^4.21.1",
		"express-rate-limit": "^8.2.1",
		"express-session": "^1.18.2",
		"helmet": "^8.0.0",
		"luxon": "^3.7.2",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"redis": "^5.10.0",
		"swagger-ui-express": "^5.0.1",
		"zod": "^4.1.8"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.9",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/express-session": "^1.18.2",
		"@types/luxon": "^3.7.1",
		"@types/node": "^24.3.1",
		"@types/supertest": "^6.0.3",
		"@types/swagger-ui-express": "^4.1.8",
		"dotenv": "^17.4.2",
		"dotenv-cli": "^11.0.0",
		"pino-pretty": "^13.1.3",
		"prisma": "^6.17.1",
		"supertest": "^7.1.4",
		"tsx": "^4.20.6",
		"typescript": "^5.9.2",
		"vitest": "^4.0.14"
	}
}
